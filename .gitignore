# Local environment and secrets
.env
**/.env

# Go build and hot-reload output
backend/tmp/
backend/api.exe

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/

# Local editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Other env variants. `.env` above does not match `.env.local` / `.env.production`,
# and the *.example files must stay tracked — the README tells you to copy them.
.env.*
!.env.example
!.env.deploy.example

# Let's Encrypt state, created on the server by the certbot container.
nginx/certbot/

# Go test and build artifacts not covered above
/backend/bin/
*.test
*.out

