# Copy to ~/isistasiun-be/.env on the VPS and fill in the real secrets. The
# deploy workflow does NOT touch this file — it is the single source of truth
# for the box.

# ---- deploy identity ----
COMPOSE_PROJECT_NAME=isistasiun-dev
APP_ENV=production
APP_PORT=8080

# TLS + routing is done by the box's shared reverse proxy (trackster-nginx-1).
# It should proxy api.dev.isistasiun.trackster.cloud to
#   http://isistasiun-dev-backend-1:8080   (on the shared-web-net network)

# ---- Postgres (our own container — needs PostGIS, internal only) ----
POSTGRES_USER=isistasiun
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=isistasiun
DATABASE_URL=postgres://isistasiun:CHANGE_ME_long_random@postgres:5432/isistasiun?sslmode=disable

# ---- API ----
JWT_SECRET=CHANGE_ME_use_at_least_32_random_characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
AUTH_RATE_LIMIT_RPM=10
AUTH_COOKIE_DOMAIN=
PIPELINE_SERVICE_API_KEY=CHANGE_ME_long_random
AI_SERVICE_URL=http://127.0.0.1:1
AI_SERVICE_TIMEOUT_SECONDS=15
RATE_LIMIT_RPM=60
# nginx talks to the API over the compose bridge network; trust that range so
# X-Forwarded-For (and thus per-IP rate limiting) is honoured.
TRUSTED_PROXIES=172.16.0.0/12
CORS_ALLOWED_ORIGINS=https://dev.isistasiun.trackster.cloud

# ---- Pipeline (batch profile) ----
GEMINI_API_KEY=CHANGE_ME
GEO_MAPID_API_KEY=CHANGE_ME
GEO_MAPID_BASE_URL=https://api.geo.mapid.io
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=isi-stasiun-media
BACKEND_CALLBACK_BASE_URL=http://backend:8080/api/v1
BACKEND_CALLBACK_API_KEY=CHANGE_ME_long_random
