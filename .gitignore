# Local environment and secrets
.env
**/.env

# Go build and hot-reload output
backend/tmp/
backend/api.exe

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/

# Local editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Other env variants. `.env` above does not match `.env.local` / `.env.production`,
# and `.env.example` must stay tracked — the README tells you to copy it.
.env.*
!.env.example

# Go test and build artifacts not covered above
/backend/bin/
*.test
*.out

