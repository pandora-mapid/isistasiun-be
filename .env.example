# ---- Shared / Compose ----
POSTGRES_USER=isistasiun
POSTGRES_PASSWORD=changeme
POSTGRES_DB=isistasiun
POSTGRES_PORT=5432

# ---- Backend (Go API) ----
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://isistasiun:changeme@postgres:5432/isistasiun?sslmode=disable
JWT_SECRET=changeme-super-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
PIPELINE_SERVICE_API_KEY=changeme-service-key
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TIMEOUT_SECONDS=15
RATE_LIMIT_RPM=60
# Set this to the Nginx network IP/CIDR in deployments that expose only Nginx.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Pipeline (Python batch) ----
GEO_MAPID_API_KEY=changeme
GEO_MAPID_BASE_URL=https://api.geo.mapid.io
GEMINI_API_KEY=changeme
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=isi-stasiun-media
BACKEND_CALLBACK_BASE_URL=http://backend:8080/api/v1
BACKEND_CALLBACK_API_KEY=changeme-service-key
