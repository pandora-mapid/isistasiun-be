APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://isistasiun:changeme@localhost:5432/isistasiun?sslmode=disable
JWT_SECRET=changeme-use-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
AUTH_RATE_LIMIT_RPM=10
AUTH_COOKIE_DOMAIN=
PIPELINE_SERVICE_API_KEY=changeme-service-key
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=15
RATE_LIMIT_RPM=60
# TTL (seconds) for the station-summary response cache (Compare View).
SUMMARY_CACHE_TTL_SECONDS=300
# Comma-separated proxy IPs or CIDRs allowed to provide X-Forwarded-For.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000
